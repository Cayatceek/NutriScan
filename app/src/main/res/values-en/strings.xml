    <string name="first_aid_subtitle">Quick steps for allergy symptoms, urgent reactions, and additive awareness.</string>
    <string name="first_aid_emergency_title">Emergency steps</string>
    <string name="first_aid_emergency_body">Stop eating immediately, check breathing, use prescribed emergency medication if you have it, and call emergency services when symptoms escalate quickly.</string>
    <string name="first_aid_symptoms_title">Common symptoms</string>
    <string name="first_aid_symptoms_body">Watch for itching, swelling, hives, stomach pain, wheezing, vomiting, throat tightness, or sudden weakness after eating.</string>
    <string name="first_aid_urgent_title">When it is urgent</string>
    <string name="first_aid_urgent_body">Treat throat swelling, shortness of breath, fainting, confusion, and rapidly spreading reactions as medical emergencies.</string>
    <string name="first_aid_additives_title">Additives encyclopedia</string>
    <string name="first_aid_additives_body">E102 is a coloring additive and E621 is a flavor enhancer. Sensitive users may want to review them more carefully before regular consumption.</string>
